SECOND_LIVE_HOST=0.0.0.0
SECOND_LIVE_PORT=8765
SECOND_LIVE_TOKEN=replace-with-a-long-random-secret
# Optional HTTPS (start.sh --https sets these automatically)
SECOND_LIVE_HTTPS=0
# SECOND_LIVE_TLS_HOST=192.168.3.100

# Optional: contact URL or email for the Wikimedia client User-Agent
# SECOND_LIVE_WIKIMEDIA_CONTACT=https://your-site.example/contact

# Account allowed to manage updates; activate it once on the Docker host.
# SECOND_LIVE_UPDATE_ADMIN_EMAIL=admin@example.invalid
# Legacy rollback compatibility only (not accepted by current HTTP API).
# SECOND_LIVE_UPDATE_ADMIN_TOKEN=
